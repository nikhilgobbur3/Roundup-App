COMPOSIO_API_KEY=
# Optional: pin which Hashnode publication to publish to. If empty, the first
# publication found on the connected Hashnode account is used automatically.
HASHNODE_PUBLICATION_ID=

# Optional: Notion database used by scripts/tracking/notion-sync.mjs. If empty,
# the sync searches Notion for a database titled "RoundUp Tracking".
NOTION_DATABASE_ID=

# Cold email outreach (scripts/email/) — free Brevo plan, 300 emails/day, no card.
# Create an account at https://www.brevo.com, verify a sender address, and copy
# the API key here / into the BREVO_API_KEY Actions secret.
BREVO_API_KEY=
# Display name shown on sent emails, e.g. "Nikhil G".
EMAIL_FROM_NAME=
# The sender address you verified inside Brevo (NOT your personal Gmail).
EMAIL_FROM_ADDRESS=
